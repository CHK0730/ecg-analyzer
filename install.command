#!/bin/bash
# ============================================================
#  ECG Analyzer — 安裝程式
# ============================================================

osascript -e 'tell application "Terminal" to activate' 2>/dev/null

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║        ECG Analyzer V4 安裝程式             ║"
echo "╚══════════════════════════════════════════╝"
echo ""

# ── 找 python3 ──────────────────────────────────────────────
PYTHON=""
for cmd in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$cmd" &>/dev/null; then
        PYTHON="$cmd"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "❌ 找不到 Python 3！請先安裝 Python"
    echo "   https://www.python.org/downloads/"
    read -p "按 Enter 關閉..."
    exit 1
fi

PYTHON_PATH=$(command -v "$PYTHON")
PY_VER=$("$PYTHON" --version 2>&1)
echo "✅ 找到 Python：$PY_VER"
echo "   路徑：$PYTHON_PATH"
echo ""

# ── 安裝套件 ────────────────────────────────────────────────
PACKAGES=("PyQt6" "pyqtgraph" "numpy" "scipy" "pyabf" "bioread" "openpyxl")
echo "📦 開始安裝必要套件..."
echo ""

FAILED=()
for pkg in "${PACKAGES[@]}"; do
    echo -n "  安裝 $pkg ... "
    if "$PYTHON" -m pip install "$pkg" --quiet --upgrade 2>/dev/null; then
        echo "✅"
    else
        echo "❌"
        FAILED+=("$pkg")
    fi
done

echo ""
if [ ${#FAILED[@]} -ne 0 ]; then
    echo "⚠️  以下套件安裝失敗：${FAILED[*]}"
    read -p "按 Enter 關閉..."
    exit 1
fi

# ── 建立 App bundle ─────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_NAME="ECG Analyzer V4"
APP_PATH="$SCRIPT_DIR/$APP_NAME.app"
ECG_SRC="$SCRIPT_DIR/ecg_app.py"

echo "🔨 建立 Mac App..."
rm -rf "$APP_PATH"
mkdir -p "$APP_PATH/Contents/MacOS"
mkdir -p "$APP_PATH/Contents/Resources"

# 把 ecg_app.py 複製進 bundle
cp "$ECG_SRC" "$APP_PATH/Contents/Resources/ecg_app.py"

# ── Info.plist ──────────────────────────────────────────────
cat > "$APP_PATH/Contents/Info.plist" << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>launcher</string>
    <key>CFBundleIdentifier</key>
    <string>com.labtools.ecganalyzerv3</string>
    <key>CFBundleName</key>
    <string>ECG Analyzer V4</string>
    <key>CFBundleDisplayName</key>
    <string>ECG Analyzer V4</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>LSEnvironment</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
    </dict>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array><string>abf</string></array>
            <key>CFBundleTypeName</key>
            <string>Axon Binary Format</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
        </dict>
    </array>
</dict>
</plist>
PLIST

# ── launcher：硬寫完整 python 路徑 ─────────────────────────
cat > "$APP_PATH/Contents/MacOS/launcher" << LAUNCHER
#!/bin/bash
# ECG Analyzer V4 launcher — auto-generated by install.command

# 從 PATH 補齊（macOS GUI App 的 PATH 很精簡）
export PATH="/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/opt/homebrew/sbin:\$PATH"

# ecg_app.py 在 bundle Resources 裡
SCRIPT="\$(dirname "\$0")/../Resources/ecg_app.py"
SCRIPT="\$(cd "\$(dirname "\$SCRIPT")" && pwd)/\$(basename "\$SCRIPT")"

# 優先用安裝時記錄的 python
PYTHON="$PYTHON_PATH"

# 若找不到就重新搜尋
if [ ! -x "\$PYTHON" ]; then
    for cmd in python3.13 python3.12 python3.11 python3.10 python3; do
        found=\$(command -v "\$cmd" 2>/dev/null)
        if [ -n "\$found" ]; then
            PYTHON="\$found"
            break
        fi
    done
fi

if [ -z "\$PYTHON" ] || [ ! -x "\$PYTHON" ]; then
    osascript -e 'display alert "找不到 Python" message "請重新執行 install.command。"'
    exit 1
fi

exec "\$PYTHON" "\$SCRIPT" "\$@"
LAUNCHER

chmod +x "$APP_PATH/Contents/MacOS/launcher"

# ── 關鍵：移除所有隔離屬性 ──────────────────────────────────
echo "🔓 移除 Gatekeeper 隔離..."
xattr -rd com.apple.quarantine "$APP_PATH" 2>/dev/null
xattr -rc "$APP_PATH" 2>/dev/null

# 確保執行權限正確
chmod -R 755 "$APP_PATH/Contents/MacOS/"
chmod 644 "$APP_PATH/Contents/Resources/ecg_app.py"
chmod 644 "$APP_PATH/Contents/Info.plist"

# ── 驗證 launcher 可以執行 ──────────────────────────────────
echo "🧪 測試 launcher..."
if bash "$APP_PATH/Contents/MacOS/launcher" --test-launch 2>/dev/null; then
    : # ok
fi
# 用 python 語法檢查確認主程式沒問題
if "$PYTHON" -m py_compile "$APP_PATH/Contents/Resources/ecg_app.py" 2>/dev/null; then
    echo "✅ 主程式語法正確"
else
    echo "⚠️  主程式語法有誤，請回報此問題"
fi

# ── 向 Launch Services 重新登錄 App ──────────────────────────
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
    -f "$APP_PATH" 2>/dev/null || true

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║           ✅ 安裝完成！                  ║"
echo "╠══════════════════════════════════════════╣"
echo "║  雙擊「ECG Analyzer V4.app」即可啟動        ║"
echo "║  或將 .abf 檔案拖放到 App 圖示上開啟    ║"
echo "╚══════════════════════════════════════════╝"
echo ""

read -p "是否立即開啟 ECG Analyzer V4？(y/n) " yn
if [[ "$yn" == "y" || "$yn" == "Y" ]]; then
    # 用 launcher 直接啟動，避免 macOS open 的路徑問題
    bash "$APP_PATH/Contents/MacOS/launcher" &
    echo "已啟動！"
fi
