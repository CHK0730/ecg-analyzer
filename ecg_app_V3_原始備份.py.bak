#!/usr/bin/env python3
from __future__ import annotations
"""
ECG Analyzer V3 — Main Application
====================================
Mac App 主程式，使用 PyQt6 + pyqtgraph 建立原生視窗介面
功能：
  - 拖放或選擇 .abf / .edf 檔案
  - 互動式波形瀏覽（縮放、平移）
  - 時間測量工具
  - 時間戳記管理與儲存 (JSON + CSV)
  - R-peak 自動偵測
  - 截圖匯出
"""

import sys
import os
import json
import csv
import struct
import datetime
import traceback

# ── 依賴確認 ──────────────────────────────────────────────────────────────────
def check_deps():
    missing = []
    for pkg in ['PyQt6', 'pyqtgraph', 'numpy', 'scipy']:
        try:
            __import__(pkg)
        except ImportError:
            missing.append(pkg)
    return missing

missing = check_deps()
if missing:
    try:
        from PyQt6.QtWidgets import QApplication, QMessageBox
        app = QApplication(sys.argv)
        QMessageBox.critical(None, "缺少套件",
            f"請先執行 install.command 安裝以下套件：\n\n" +
            "\n".join(missing))
        sys.exit(1)
    except Exception:
        print(f"[ERROR] 缺少套件：{missing}")
        print("請執行 install.command")
        sys.exit(1)

